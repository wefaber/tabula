{
  "name": "tabula",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "TABULA_FIXTURES=1 bun --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "bun server/index.ts",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "token": "bun scripts/token.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pothos/core": "^4.16.0",
    "@tanstack/react-query": "^5.105.0",
    "@wefaber/gitview": "^0.2.1",
    "@wefaber/orb": "^0.5.1",
    "@wefaber/tokens": "^0.2.1",
    "@wefaber/ui": "^0.3.1",
    "animejs": "^4.5.0",
    "elysia": "^1.4.30",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
